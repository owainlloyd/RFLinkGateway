{
  "mqtt_host": "mosquitto.owainlloyd.info",
  "mqtt_port": 1883,
  "mqtt_prefix": "RFLINK",
  "mqtt_format": "json",
  "mqtt_message_timeout": 60,
  "mqtt_user":"",
  "mqtt_password":"",
  "rflink_connection_type":"tcp",
  "rflink_tty_device": "/dev/ttyUSB0",
  "rflink_baudrate": 57600,
  "rflink_tcp_host": "192.168.1.246",
  "rflink_tcp_port" : 1234,
  "rflink_direct_output_params": [
    "BAT",
    "CMD",
    "SET_LEVEL",
    "SWITCH",
    "HUM",
    "CHIME",
    "PIR",
    "SMOKEALERT"
  ],
  "rflink_signed_output_params": [
    "TEMP",
    "WINCHL",
    "WINTMP"
  ],
  "rflink_wdir_output_params": [
    "WINDIR"
  ],
  
  "ha_discovery": {
    "enabled": true,
    "prefix": "homeassistant",
    "families": {
      "Alecto V4": {
        "device_type": "temperature_humidity",
        "manufacturer": "Alecto",
        "model": "V4"
        }
      },
    "device_types": {
      "temperature_humidity": {
        "parameters": {
          "TEMP": {
            "device_class": "temperature",
            "unit": "°C"
          },
          "HUM": {
            "device_class": "humidity",
            "unit": "%"
          }
        }
      }
    }
  }
}
